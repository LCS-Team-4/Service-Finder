PORT=5000
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_supabase_service_key
MAPS_API_KEY=your_maps_api_key_here
MAPS_DAILY_LIMIT=1000
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
GEOAPIFY_API_KEY=your_geoapify_api_key_here
TOMTOM_SEARCH_URL=https://api.tomtom.com/search/2
TOMTOM_SERVICE_CATEGORIES=school,primary school,high school,hospital,clinic,pharmacy,dentist,library,police,fire station,shelter,government office
# Semicolon-separated latitude,longitude centers. Add centers for each region to expand coverage.
TOMTOM_SERVICE_CENTERS=-33.9249,18.4241;-29.8587,31.0218;-26.2041,28.0473;-25.7479,28.2293;-33.918,18.4233;-33.9608,18.4617;-29.0852,26.1596;-23.9045,29.4689;-28.7282,24.7499
TOMTOM_SERVICE_RADIUS=50000
TOMTOM_SERVICE_MAX_PAGES=3
GEOAPIFY_MAX_PAGES=3
ADMIN_IMPORT_TOKEN=use_a_long_random_value
# Optional. Leave blank to disable automatic imports.
IMPORT_INTERVAL_MS=0
