{
  "compilerOptions": {
  "target": "ES2020",
  "module": "NodeNext",
  "moduleResolution": "NodeNext",
  "rootDir": "src",
  "outDir": "dist",
  "strict": true,
  "esModuleInterop": true,
  "skipLibCheck": true,
  "sourceMap": true
},
  "include": ["./**/*"],
  "exclude": ["node_modules", "dist"]
}