  color: #593317;
  font: bold 15px Georgia;
  letter-spacing: 8px;
  box-shadow: 0 0 0 6px rgba(90, 51, 20, 0.13);
}
.story-content {
  max-width: 560px;
  text-align: left;
  align-items: flex-start;
}
.brand {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10px;
  color: var(--ink);
  text-transform: uppercase;
  margin-right: auto;
}
.brand-mark {
  width: 96px;
  height: 96px;
  background: none !important;
  box-shadow: none !important;
  transform: none !important;
  color: var(--ink);
  font-size: 32px;
  line-height: 0.7;
  display: grid;
  place-items: center;
}
.brand-mark span {
  display: none;
}
.brand-mark:before {
  content: "✦";
}
.brand-mark svg {
  width: 96px;
  height: 96px;
  display: block;
}
.brand-name {
  font:
    600 clamp(33px, 4vw, 59px)/0.9 Georgia,
    serif;
  letter-spacing: 3px;
  text-shadow: 1px 1px #f7d996;
}
.brand-name span {
  color: inherit;
}
.story-copy {
  margin-top: clamp(65px, 11vh, 120px);
}
.eyebrow {
  margin: 0 0 18px;
  color: var(--ink);
  font:
    600 12px Georgia,
    serif;
  letter-spacing: 3px;
}
.eyebrow span {
  color: inherit;
}
.story-copy h1 {
  margin: 0;
  color: var(--ink);
  font:
    italic clamp(30px, 3.7vw, 50px)/1.12 Georgia,
    serif;
  letter-spacing: 0;
}
.story-copy h1 strong {
  color: inherit;
}
.story-description {
  margin: 20px auto 0;
  color: var(--ink);
  font:
    italic 16px/1.55 Georgia,
    serif;
}
.story-features {
  justify-content: center;
  margin-top: 55px;
}
.story-feature {
  min-width: 132px;
