  color: var(--ink);
  background:
    linear-gradient(
      105deg,
      transparent 6%,
      rgba(234, 198, 125, 0.1) 60%,
      rgba(115, 71, 29, 0.15)
    ),
    radial-gradient(
      ellipse at 25% 71%,
      rgba(59, 112, 125, 0.65) 0 19%,
      transparent 19.5%
    ),
    repeating-radial-gradient(
      ellipse at 18% 72%,
      rgba(52, 101, 115, 0.32) 0 1px,
      transparent 2px 9px
    );
}
.auth-story:after {
  content: "N  ✦  E";
