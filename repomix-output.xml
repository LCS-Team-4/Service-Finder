}
.story-feature strong {
  font:
    600 14px Georgia,
    serif;
  letter-spacing: 1px;
}
.story-feature small {
  color: var(--ink);
  font:
    italic 11px Georgia,
    serif;
}
.feature-icon {
  color: var(--ink);
}
.auth-panel {
  padding: 44px clamp(24px, 5vw, 86px);
  background: rgba(216, 168, 95, 0.2);
}
.login-card {
  width: min(100%, 505px);
  padding: 54px clamp(28px, 5vw, 58px) 42px;
  border: 1px solid var(--line);
  border-left: 1px solid var(--line);
  border-radius: 0;
  outline: 4px double rgba(112, 65, 26, 0.72);
  outline-offset: -9px;
  background:
    radial-gradient(
      circle at 70% 12%,
      rgba(255, 249, 216, 0.82),
      transparent 40%
    ),
    repeating-linear-gradient(
      -35deg,
      rgba(106, 57, 20, 0.035) 0 1px,
      transparent 1px 5px
    ),
    #f4d99e;
  box-shadow:
    13px 16px 0 rgba(88, 47, 16, 0.27),
    0 18px 34px rgba(58, 31, 11, 0.38);
}
.login-card:before {
  content: "✥";
  top: 19px;
  right: auto;
  left: 50%;
  width: auto;
  height: auto;
  border: 0;
  border-radius: 0;
  box-shadow: none;
  transform: translateX(-50%);
  color: #70421d;
  font-size: 30px;
}
.login-card:after {
  content: "";
  position: absolute;
  top: 48px;
  left: 14%;
  right: 14%;
  height: 1px;
  background: linear-gradient(90deg, transparent, #966338 18% 82%, transparent);
}
.panel-kicker {
  margin: 8px 0 10px;
  color: var(--ink);
  text-align: center;
  font:
    600 10px Georgia,
    serif;
  letter-spacing: 2.5px;
}
.login-heading h2 {
  color: var(--ink);
  text-align: center;
  text-transform: uppercase;
  font:
    500 clamp(25px, 3vw, 34px) Georgia,
    serif;
  letter-spacing: 3px;
}
.login-heading p {
  color: #60401f;
  text-align: center;
  font:
    italic 14px/1.45 Georgia,
    serif;
}
.field-label {
  position: static;
  display: block;
  width: auto;
  height: auto;
  margin: 0 0 6px;
  overflow: visible;
  clip: auto;
  color: #54331b;
  text-transform: uppercase;
  font:
    600 11px Georgia,
    serif;
  letter-spacing: 1.5px;
}
.auth-field {
  min-width: 0;
}
.auth-input,
.input-wrap input {
  height: 43px;
  border: 1px solid #9a6634;
  border-radius: 3px;
  color: #4b2c16;
  background: rgba(255, 238, 191, 0.43);
  font:
    14px Georgia,
    serif;
}
.auth-input:focus,
.input-wrap input:focus {
  border-color: #603210;
  box-shadow: 0 0 0 3px rgba(121, 72, 28, 0.16);
}
.auth-input::placeholder,
.input-wrap input::placeholder {
  color: #8b6a49;
}
.input-wrap input {
  padding: 0 42px;
}
.input-icon {
  top: 11px;
  color: #58351b;
}
.visibility-button {
  height: 43px;
  color: #58351b;
}
.form-options {
  color: #60401f;
  font:
    13px Georgia,
    serif;
}
.form-options a,
.signup-prompt a {
  color: #62320f;
}
.remember-option input {
  accent-color: #6a3b14;
}
.submit-button,
.google-button {
  height: 48px;
  border-radius: 3px;
  text-transform: uppercase;
  letter-spacing: 2px;
  font:
    600 13px Georgia,
    serif;
}
.submit-button {
  border: 1px solid #44200b;
  background: linear-gradient(105deg, #45200b, #6d3917);
  box-shadow:
    inset 0 0 0 2px rgba(255, 210, 133, 0.37),
    0 3px 5px rgba(66, 31, 10, 0.3);
}
.google-button {
  border: 1px solid #9a6634;
  color: #4a2b16;
  background: rgba(255, 237, 189, 0.45);
}
.divider {
  color: #60401f;
  font:
    12px Georgia,
    serif;
}
.divider:before,
.divider:after {
  background: #b47c43;
}
.signup-prompt {
  color: #60401f;
  font:
    13px Georgia,
    serif;
}
.form-error,
.form-success {
  border-radius: 2px;
  border-color: #9c6840;
  background: rgba(255, 238, 190, 0.67);
  font:
    12px/1.4 Georgia,
    serif;
}
@media (max-width: 820px) {
  .auth-page {
    grid-template-columns: 1fr;
  }
  .auth-story {
    min-height: 200px;
    height: 200px;
    padding: 24px 28px;
    align-items: flex-end;
  }
  .auth-story:after {
    transform: scale(0.62);
    transform-origin: top left;
    top: 30px;
    left: 36px;
  }
  .story-copy,
  .story-features {
    display: none;
  }
  .brand-name {
    font-size: 38px;
  }
  .auth-panel {
    min-height: calc(100vh - 200px);
    padding: 22px 20px 30px;
    align-items: start;
  }
  .login-card {
    margin-top: -47px;
  }
}
@media (max-width: 430px) {
  .auth-story {
    min-height: 170px;
    height: 170px;
  }
  .auth-panel {
    min-height: calc(100vh - 170px);
    padding: 14px;
  }
  .login-card {
    padding: 50px 22px 28px;
  }
  .auth-input-row {
    grid-template-columns: 1fr;
  }
  .form-options {
    font-size: 11px;
  }
}

